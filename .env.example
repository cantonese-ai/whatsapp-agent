# Copy to .env and fill in. Never commit .env.
# Lines left empty or commented out use the default shown.

# ---------------------------------------------------------------- required
# Shared secret between wwebjs-api and voice-transcriber. wwebjs-api requires it on every
# REST call (x-api-key header) and sends it on every webhook; voice-transcriber's admin API
# (/jobs, /notifications) requires it too. Generate your own, e.g.:  openssl rand -hex 32
WWEBJS_API_KEY=

# ---------------------------------------------------------------- cantonese.ai credential
# Either set an API key (an "sk-..." key from https://cantonese.ai/api-keys), sent as
# "Authorization: Bearer <key>", or leave it empty and sign in once with your cantonese.ai account:
#   docker compose run --rm voice-transcriber python app.py login
# If both exist, the API key is used.
CANTONESE_AI_API_KEY=
# OAuth public client id for "Sign in with cantonese.ai" (no client secret is used).
CANTONESE_AI_OAUTH_CLIENT_ID=whatsapp-agent
# Base URL of the authorization server (endpoints come from /.well-known/oauth-authorization-server,
# falling back to /api/oauth/authorize and /api/oauth/token).
CANTONESE_AI_ISSUER=https://cantonese.ai
CANTONESE_AI_OAUTH_SCOPE=user:inference
# Where the sign-in token is stored (file mode 0600). docker-compose.yml sets /data/cantonese-ai-token.json.
#CANTONESE_AI_TOKEN_PATH=/data/cantonese-ai-token.json

# ---------------------------------------------------------------- speech-to-text
STT_URL=https://cantonese.ai/api/stt
# Language sent to the STT API (e.g. cantonese, mandarin, english).
STT_LANG=cantonese
# WhatsApp message types to transcribe: ptt = recorded voice note, audio = forwarded audio file.
VOICE_TYPES=ptt,audio
# Prefix of every transcript reply; also how existing transcripts in a chat are recognised.
# Default "📝 " (with a trailing space, which some .env parsers strip, so it is left commented out).
#REPLY_PREFIX=📝
# Per-attempt STT timeout in seconds.
STT_TIMEOUT_S=150

# ---------------------------------------------------------------- queue and retries
WORKERS=2
MAX_ATTEMPTS=10
BACKOFF_BASE_S=2
BACKOFF_MAX_S=900
# Finished jobs (without audio) are kept this many days for GET /jobs.
KEEP_DONE_DAYS=30
# Voice notes from other people wait a random DEFER_MIN_S..DEFER_MAX_S seconds, then are skipped if
# another agent in the chat already posted a transcript of them.
DEFER_MIN_S=0
DEFER_MAX_S=3
DEDUPE_SCAN_LIMIT=50
REPLY_TIMEOUT_S=60

# ---------------------------------------------------------------- pacing (avoid looking like spam)
# At most one transcript per SEND_MIN_INTERVAL_S seconds per WhatsApp number.
SEND_MIN_INTERVAL_S=5
SEND_MAX_WAIT_S=30

# ---------------------------------------------------------------- catch-up after a restart
# wwebjs-api re-sends voice notes received while it was offline, at most this many seconds old.
CATCHUP_MAX_SECONDS=3600
# voice-transcriber only posts catch-up transcripts for notes this recent, and first searches this
# many messages of the chat for an existing transcript.
CATCHUP_MAX_AGE_S=3600
CATCHUP_SCAN_LIMIT=1000

# ---------------------------------------------------------------- optional alert e-mails (SendGrid)
# Off unless all three are set: an e-mail when a number is linked to or unlinked from the agent.
SENDGRID_API_KEY=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=

# ---------------------------------------------------------------- wwebjs-api / ports
# Host ports, bound to 127.0.0.1 only.
WWEBJS_PORT=3000
TRANSCRIBER_PORT=8080
# wwebjs-api's web dashboard (/dashboard) and Swagger UI (/api-docs) on WWEBJS_PORT.
WWEBJS_ENABLE_WEB_UI=TRUE
WWEBJS_ENABLE_SWAGGER=TRUE
# Mark incoming chats as read (FALSE suits a personal number).
SET_MESSAGES_AS_SEEN=FALSE
WWEBJS_LOG_LEVEL=info
# Per-session webhook override (upstream wwebjs-api feature): <SESSIONID>_WEBHOOK_URL, session id in
# upper case. Add it to the wwebjs-api environment in docker-compose.yml, e.g.
#   DEMO_WEBHOOK_URL: http://voice-transcriber:8080/webhook
